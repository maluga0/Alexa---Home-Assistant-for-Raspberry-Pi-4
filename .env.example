# Copy to ".env" (which is git-ignored) and adjust.
# Nothing here is a secret; it only holds paths, device numbers and choices.

# Where model caches live on the Pi. Must be writable.
PI_CACHE_DIR=/home/pi/.cache

# Wake word (openWakeWord model). e.g. alexa, hey_jarvis, hey_mycroft, okay_nabu
WAKE_WORD=alexa

# Speech-to-text.
#   Default: sherpa-onnx streaming Zipformer (fast + streaming).
#   Whisper alternative: STT_LIBRARY=faster-whisper  STT_MODEL=tiny-int8
STT_LIBRARY=sherpa
STT_MODEL=sherpa-onnx-streaming-zipformer-en-kroko-2025-08-06
STT_LANGUAGE=en

# Piper (neural TTS) voice — used only if you switch the pipeline to tts.piper.
PIPER_VOICE=en_GB-alan-low

# espeak-ng (fast, robotic TTS) default voice.
ESPEAK_VOICE=en

# Satellite
SATELLITE_NAME=PiSatellite

# Audio devices — find yours with `arecord -l` (microphone) and `aplay -l` (speaker).
MIC_COMMAND=arecord -D plughw:3,0 -r 16000 -c 1 -f S16_LE -t raw
SND_COMMAND=aplay -D plughw:2,0 -r 22050 -c 1 -f S16_LE -t raw
